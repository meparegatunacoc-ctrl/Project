def tenant_payment_history(username):
    print("\n========== MY PAYMENT HISTORY ==========")
    records = [ record for record in payment_records if record.get("username") == username]
    if not records:
        print("No verified payment records found.")
        return
    rows = []
    for record in records:
        rows.append([
            record.get("submission_id", ""),
            record.get("bill_category", ""),
            f"PHP {float(record.get('amount', 0)):.2f}",
            record.get("payment_method", ""),
            record.get("reference_number", "N/A"),
            format_datetime(record.get("paid_at")),
            record.get("status", "APPROVED")
        ])

    print_table(["Payment ID", "Bill", "Amount", "Method", "Reference", "Paid At", "Status"], rows)

