# PAYMENT SUBMISSION

def get_next_submission_id():
    ids = []
    for submission in payment_submissions:
        try:
            ids.append(int(submission.get("submission_id", 0)))
        except (ValueError, TypeError):
            pass
    return max(ids, default=0) + 1


def reference_exists(reference):
    # Check submitted payments that have not been rejected.
    for submission in payment_submissions:
        if (
            submission.get("payment_method") == "GCash"
            and submission.get("reference_number") == reference
            and submission.get("status") != "REJECTED"
        ):
            return True

    # Also check verified payment records.
    for record in payment_records:
        if (
            record.get("payment_method") == "GCash"
            and record.get("reference_number") == reference
        ):
            return True

    return False


def has_pending_payment(username, category):
    """Return True if this tenant already has a pending payment
    for the selected bill category."""
    return any(
        payment.get("username") == username
        and payment.get("bill_category") == category
        and payment.get("status") == "PENDING"
        for payment in payment_submissions
    )


def get_pending_payment_amount(username, category):
    """Calculate the amount already awaiting admin verification."""
    return round(
        sum(
            float(payment.get("amount", 0))
            for payment in payment_submissions
            if payment.get("username") == username
            and payment.get("bill_category") == category
            and payment.get("status") == "PENDING"
        ),
        2
    )


def submit_payment(username):
    print("\n========== SUBMIT PAYMENT ==========")

    display_payment_table(username)

    tenant_bills = bills.get(username, {})

    if get_tenant_balance(username) <= 0:
        print("You have no outstanding balance.")
        return

    # Only display bills that have an outstanding amount
    # and do not already have a pending payment submission.
    available_bills = []

    for category in BILL_CATEGORIES:
        bill = tenant_bills.get(category)

        if not bill:
            continue

        balance = get_balance(bill)

        if balance <= 0:
            continue

        if has_pending_payment(username, category):
            print(
                f"\n{category}: You have already submitted "
                "a payment for this bill."
            )
            print(
                "Please wait for admin verification before "
                "submitting another payment."
            )
            continue

        # Reserve amounts from other pending submissions
        # to avoid allowing payments beyond the remaining balance.
        pending_amount = get_pending_payment_amount(
            username, category
        )
        remaining = round(balance - pending_amount, 2)

        if remaining > 0:
            available_bills.append(category)

    if not available_bills:
        print("\nNo bills are currently available for payment.")
        print(
            "Please wait for pending payments to be verified "
            "or check your outstanding bills."
        )
        return

    print("\nSELECT BILL")

    for index, category in enumerate(available_bills, 1):
        bill = tenant_bills[category]
        balance = get_balance(bill)

        print(
            f"{index}. {category} - "
            f"PHP {balance:.2f}"
        )

    choice = get_numeric_choice(
        "Choose bill number: ",
        1,
        len(available_bills)
    )

    category = available_bills[choice - 1]

    # Check again before proceeding.
    if has_pending_payment(username, category):
        print(
            "You have already submitted a payment for this bill. "
            "Please wait for admin verification."
        )
        return

    bill = tenant_bills[category]
    balance = get_balance(bill)

    amount = get_amount(
        "Enter payment amount (PHP): ",
        allow_zero=False
    )

    if amount > balance:
        print("Payment cannot exceed the outstanding balance.")
        return

    print("\nPAYMENT METHOD")
    print("1. Cash")
    print("2. GCash")

    method_choice = get_numeric_choice(
        "Choose method: ", 1, 2
    )

    if method_choice == 1:
        method = "Cash"
        reference = "N/A"

    else:
        method = "GCash"
        view_gcash_info()

        while True:
            reference = input(
                "Enter GCash reference number (numbers only): "
            ).strip()

            if not reference.isdigit():
                print(
                    "Invalid reference number. "
                    "Enter numbers only."
                )
                continue

            if reference_exists(reference):
                print(
                    "Reference number already used. "
                    "Please enter a different reference number."
                )
                continue

            break

    # Final duplicate check before saving.
    if has_pending_payment(username, category):
        print(
            "You have already submitted a payment for this bill. "
            "Please wait for admin verification."
        )
        return

    # Recheck the bill balance before creating the submission.
    current_balance = get_balance(
        bills.get(username, {}).get(category, {})
    )

    if amount > current_balance:
        print(
            "Payment cannot exceed the current outstanding balance."
        )
        return

    submission = {
        "submission_id": get_next_submission_id(),
        "username": username,
        "full_name": tenants[username].get("full_name", ""),
        "room": tenants[username].get("room", ""),
        "bill_category": category,
        "amount": amount,
        "payment_method": method,
        "reference_number": reference,
        "status": "PENDING",
        "submitted_at": now().isoformat(),
        "verified_at": None
    }

    payment_submissions.append(submission)
    save_data()

    print("\nPayment submitted successfully.")
    print(f"Submission ID: {submission['submission_id']}")
    print(f"Bill Category: {category}")
    print(f"Amount: PHP {amount:.2f}")
    print(f"Payment Method: {method}")
    print("Status: PENDING")
    print(
        "Please wait for the admin to verify your payment."
    )


