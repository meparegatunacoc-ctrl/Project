        if username == ADMIN_USERNAME and password == ADMIN_PASSWORD:
            print("Admin login successful.")
            admin_menu()
        else:
            print("Invalid admin username or password.")

    elif choice == "2":
        username = input("Tenant username: ").strip()
        password = input("Tenant password: ").strip()
        if (username in tenants and tenants[username].get("password") == password):
            print("Tenant login successful.")
            tenant_menu(username)
