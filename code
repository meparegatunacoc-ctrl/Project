# BILL FUNCTIONS

def get_balance(bill):
    return max(
        round(
            float(bill.get("amount", 0))
            - float(bill.get("paid", 0)),
            2
        ),
        0
    )

def get_status(bill):
    amount = float(bill.get("amount", 0))
    paid = float(bill.get("paid", 0))
    balance = get_balance(bill)
    if amount <= 0:
        return "NO BILL"
    if balance <= 0:
        return "PAID"
    due_date = parse_datetime(bill.get("due_date"))
    if due_date and now().date() > due_date.date():
        return "OVERDUE"
    if paid > 0:
        return "PARTIAL"
    return "UNPAID"

def get_tenant_balance(username):
    return round(
        sum(
            get_balance(bill)
            for bill in bills.get(username, {}).values()
        ),
        2
    )

def display_payment_table(username):
    rows = []
    for category in BILL_CATEGORIES:
        bill = bills.get(username, {}).get(category)
        if bill:
            rows.append([
                category,
                f"PHP {float(bill.get('amount', 0)):.2f}",
                f"PHP {float(bill.get('paid', 0)):.2f}",
                f"PHP {get_balance(bill):.2f}",
                format_date(bill.get("due_date")),
                get_status(bill)
            ])
    print_table(["Bill Category", "Amount", "Paid", "Balance", "Due Date", "Status"], rows)
    print(f"TOTAL BALANCE: PHP {get_tenant_balance(username):.2f}")


# GENERATE OR UPDATE BILL

def generate_bill():
    print("\n========== GENERATE / UPDATE BILL ==========")
    if not tenants:
        print("No tenant accounts found.")
        return
    view_tenant_accounts()
    username = input("Enter tenant username: ").strip()
    if username not in tenants:
        print("Tenant account not found.")
        return
    print("\nBILL CATEGORIES")
    for index, category in enumerate(BILL_CATEGORIES, 1):
        print(f"{index}. {category}")

    choice = get_numeric_choice(
        "Choose bill category: ",
        1,
        len(BILL_CATEGORIES)
    )
    category = BILL_CATEGORIES[choice - 1]
    old_bill = bills[username].get(category, {
        "amount": 0,
        "paid": 0,
        "due_date": None,
        "updated_at": None
    })
    print(f"Previously Paid: PHP {float(old_bill.get('paid', 0)):.2f}")
