# DATE FUNCTIONS

def now():
    return datetime.now()

def add_one_month(date_value):
    month = date_value.month + 1
    year = date_value.year
    if month > 12:
        month = 1
        year += 1
    last_day = calendar.monthrange(year, month)[1]
    return date_value.replace(
        year=year,
        month=month,
        day=min(date_value.day, last_day)
    )

def parse_datetime(value):
    if isinstance(value, datetime):
        return value
    if not value:
        return None
    try:
        return datetime.fromisoformat(value)
    except (ValueError, TypeError):
        return None

def format_date(value):
    parsed = parse_datetime(value)
    return parsed.strftime("%Y-%m-%d") if parsed else "Not set"

def format_datetime(value):
    parsed = parse_datetime(value)
    return parsed.strftime("%Y-%m-%d %I:%M %p") if parsed else "Not recorded"

# TABLE FUNCTION

def print_table(headers, rows):
    if not headers:
        return
    rows = [
        [str(value) if value is not None else "" for value in row]
        for row in rows
    ]

    widths = []

    for index, header in enumerate(headers):
        width = len(str(header))
        for row in rows:
            if index < len(row):
                width = max(width, len(row[index]))
        widths.append(width)
    separator = "-+-".join("-" * width for width in widths)
    print()
    print(" | ".join(
        str(header).ljust(widths[index])
        for index, header in enumerate(headers)
    ))
    print(separator)
    for row in rows:
        print(" | ".join(
            row[index].ljust(widths[index])
            for index in range(len(headers))
        ))
    print()

# SAVE AND LOAD DATA

def save_data():
    data = {
        "rooms": rooms,
        "tenants": tenants,
        "bills": bills,
        "payment_submissions": payment_submissions,
        "payment_records": payment_records
    }
    try:
        with DATA_FILE.open("w", encoding="utf-8") as file:
            json.dump(data, file, indent=4, default=str)
    except OSError as error:
        print(f"Error saving data: {error}")

def sync_room_occupancy():
    for room_number in rooms:
        rooms[room_number]["occupied"] = 0
    for tenant in tenants.values():
        room_number = tenant.get("room")
        if room_number in rooms:
            rooms[room_number]["occupied"] += 1

def load_data():
    global rooms, tenants, bills
    global payment_submissions, payment_records
    if not DATA_FILE.exists():
        return
    try:
        with DATA_FILE.open("r", encoding="utf-8") as file:
            data = json.load(file)
        loaded_rooms = data.get("rooms", {})
        for room_number, details in DEFAULT_ROOMS.items():
            loaded_rooms.setdefault(room_number, details.copy())
        rooms = loaded_rooms
        tenants = data.get("tenants", {})
        bills = data.get("bills", {})
        payment_submissions = data.get("payment_submissions", [])
        payment_records = data.get("payment_records", [])
        if not isinstance(payment_submissions, list):
            payment_submissions = []
        if not isinstance(payment_records, list):
            payment_records = []
        for username, tenant in tenants.items():
            bills.setdefault(username, {})
            room_number = tenant.get("room")
            rent = rooms.get(room_number, {}).get("rent", 0)
            bills[username].setdefault("Monthly Rent", {
                "amount": rent,
                "paid": 0,
                "due_date": add_one_month(now()).isoformat(),
                "updated_at": now().isoformat()
            })
            for category in BILL_CATEGORIES:
                bills[username].setdefault(category, {
                    "amount": 0,
                    "paid": 0,
                    "due_date": None,
                    "updated_at": None
                })
                bills[username][category].setdefault("amount", 0)
                bills[username][category].setdefault("paid", 0)
                bills[username][category].setdefault("due_date", None)
                bills[username][category].setdefault("updated_at", None)
        for submission in payment_submissions:
            submission.setdefault("payment_method", "Cash")
            submission.setdefault("reference_number", "N/A")
            submission.setdefault("status", "PENDING")
            submission.setdefault("submitted_at", None)
            submission.setdefault("verified_at", None)
            if submission["payment_method"] == "Cash":
                submission["reference_number"] = "N/A"
        for record in payment_records:
            record.setdefault("payment_method", "Cash")
            record.setdefault("reference_number", "N/A")
            record.setdefault("paid_at", None)
            if record["payment_method"] == "Cash":
                record["reference_number"] = "N/A"
        sync_room_occupancy()
        save_data()
    except (OSError, json.JSONDecodeError, TypeError) as error:
        print(f"Error loading data: {error}")

# INPUT FUNCTIONS

def get_nonempty_input(prompt):
    while True:
        value = input(prompt).strip()
        if value:
            return value
        print("Input cannot be empty.")

def get_numeric_choice(prompt, minimum, maximum):
    while True:
        value = input(prompt).strip()
        if not value.isdigit():
            print("Please enter a number.")
            continue
        choice = int(value)
        if minimum <= choice <= maximum:
            return choice
        print(f"Enter a number from {minimum} to {maximum}.")

def get_amount(prompt, allow_zero=True):
    while True:
        try:
            amount = round(float(input(prompt).strip()), 2)
            if amount < 0 or (not allow_zero and amount == 0):
                print("Enter a valid positive amount.")
                continue
            return amount
        except ValueError:
            print("Invalid amount. Please enter a number.")


# VALIDATE DUE DATE
# PAST DATES ARE NOT ALLOWED

def get_valid_date(prompt):
    while True:
        value = input(prompt).strip()
        try:
            selected_date = datetime.strptime(
                value, "%Y-%m-%d"
            ).date()
            if selected_date.isoformat() != value:
                print("Invalid date. Use YYYY-MM-DD format.")
                continue
            if selected_date < now().date():
                print("Invalid date. Due date cannot be in the past.")
                continue
            return datetime.combine(
                selected_date,
                datetime.min.time()
            ).isoformat()
        except ValueError:
            print("Invalid date. Please use YYYY-MM-DD format.")


