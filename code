def display_available_rooms():
    rows = []
    for room_number, details in rooms.items():
        available = details["capacity"] - details["occupied"]
        rows.append([
            room_number,
            f"PHP {details['rent']:.2f}",
            details["capacity"],
            details["occupied"],
            max(available, 0),
            "Available" if available > 0 else "Full"
        ])
    print_table(
        ["Room", "Monthly Rent", "Capacity", "Occupied", "Available", "Status"],
        rows
    )

def get_room_by_choice():
    room_numbers = list(rooms.keys())
    while True:
        available_rooms = [
            room_number for room_number in room_numbers
            if rooms[room_number]["occupied"] < rooms[room_number]["capacity"]
        ]
        if not available_rooms:
            print("\nAll rooms are full.")
            print("Returning to the Admin Menu...")
            return None
        print("\nAVAILABLE ROOMS")
        rows = []
        for index, room_number in enumerate(room_numbers, 1):
            details = rooms[room_number]
            available = details["capacity"] - details["occupied"]
            rows.append([
                index,
                room_number,
                f"PHP {details['rent']:.2f}",
                max(available, 0),
                "Available" if available > 0 else "Full"
            ])
        print_table(
            ["Choice", "Room Number", "Monthly Rent",
             "Slots Available", "Status"],
            rows
        )
        choice = get_numeric_choice(
            "Enter room choice number (0 to return to menu): ",
            0,
            len(room_numbers)
        )
        if choice == 0:
            print("Returning to the Admin Menu...")
            return None
        room_number = room_numbers[choice - 1]
        if rooms[room_number]["occupied"] < rooms[room_number]["capacity"]:
            return room_number
        print("That room is full. Choose another room.")

# CREATE TENANT ACCOUNT

def create_tenant():
    print("\n========== CREATE TENANT ACCOUNT ==========")
    if all(
        details["occupied"] >= details["capacity"]
        for details in rooms.values()
    ):
        print("\nAll rooms are full.")
        print("Returning to the Admin Menu...")
        return
    username = get_nonempty_input("Create username: ")
    if username.lower() == ADMIN_USERNAME.lower():
        print("This username is reserved.")
        return
    if username in tenants:
        print("Username already exists.")
        return
    password = get_nonempty_input("Create password: ")
    full_name = get_nonempty_input("Tenant full name: ")
    contact = get_nonempty_input("Contact number: ")
    room_number = get_room_by_choice()
    if room_number is None:
        return
    tenants[username] = {
        "username": username,
        "password": password,
        "full_name": full_name,
        "contact": contact,
        "room": room_number,
        "created_at": now().isoformat()
    }
    rooms[room_number]["occupied"] += 1
    rent = rooms[room_number]["rent"]
    due_date = add_one_month(now()).isoformat()
    bills[username] = {
        "Monthly Rent": {
            "amount": rent,
            "paid": 0,
            "due_date": due_date,
            "updated_at": now().isoformat()
        },
        "Electricity": {
            "amount": 0,
            "paid": 0,
            "due_date": None,
            "updated_at": None
        },
        "Water": {
            "amount": 0,
            "paid": 0,
            "due_date": None,
            "updated_at": None
        }
    }
    save_data()
    print("\nTenant account created successfully.")
    print(f"Username: {username}")
    print(f"Full Name: {full_name}")
    print(f"Room: {room_number}")
    print(f"Monthly Rent: PHP {rent:.2f}")
    print(f"Rent Due Date: {format_date(due_date)}")

