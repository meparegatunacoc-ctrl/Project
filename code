# ADMIN: VERIFY PAYMENT

def verify_payment():
    print("\n========== VERIFY PAYMENT ==========")

    pending = [
        payment for payment in payment_submissions
        if payment.get("status") == "PENDING"
    ]

    if not pending:
        print("No pending payments.")
        return

    print_table(
        ["ID", "Username", "Bill", "Amount", "Method", "Reference"],
        [
            [
                payment.get("submission_id", ""),
                payment.get("username", ""),
                payment.get("bill_category", ""),
                f"PHP {float(payment.get('amount', 0)):.2f}",
                payment.get("payment_method", ""),
                payment.get("reference_number", "N/A")
            ]
            for payment in pending
        ]
    )

    submission_id = get_numeric_choice(
        "Enter submission ID: ",
        1,
        max(int(p["submission_id"]) for p in pending)
    )
    selected = next(
        (
            payment for payment in pending
            if int(payment["submission_id"]) == submission_id
        ),
        None
    )
    if selected is None:
        print("Pending payment not found.")
        return

    print("1. Approve")
    print("2. Reject")
    print("3. Cancel")

    action = get_numeric_choice("Choose action: ", 1, 3)

    if action == 3:
        print("Cancelled.")
        return

    if action == 2:
        selected["status"] = "REJECTED"
        selected["verified_at"] = now().isoformat()
        save_data()
        print("Payment rejected.")
        return

    username = selected.get("username")
    category = selected.get("bill_category")
    if username not in tenants:
        print("Tenant account no longer exists.")
        return
    bill = bills.get(username, {}).get(category)
    if not bill:
        print("Bill not found.")
        return
    amount = float(selected.get("amount", 0))
    if amount <= 0 or amount > get_balance(bill):
        print("Cannot approve: payment exceeds the current balance.")
        return
    bill["paid"] = round(float(bill.get("paid", 0)) + amount, 2)
    bill["updated_at"] = now().isoformat()
    selected["status"] = "APPROVED"
    selected["verified_at"] = now().isoformat()
    payment_records.append({
        "submission_id": selected.get("submission_id"),
        "username": username,
        "full_name": tenants[username].get("full_name", ""),
        "room": tenants[username].get("room", ""),
        "bill_category": category,
        "amount": amount,
        "payment_method": selected.get("payment_method", "Cash"),
        "reference_number": selected.get("reference_number", "N/A"),
        "paid_at": now().isoformat(),
        "status": "APPROVED"
    })

    save_data()
    print("Payment approved successfully.")

